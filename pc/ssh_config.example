# 追加到 PC 的 ~/.ssh/config（C:\Users\<你>\.ssh\config）
# 开启隧道: ssh -N vps-tunnel
# 隧道开着时，VPS 访问自己的 localhost:2222 就等于访问 PC 的 22 端口。
Host vps-tunnel
    HostName vps.example.com
    User your-vps-user
    IdentityFile ~/.ssh/id_ed25519_vps
    RemoteForward 2222 localhost:22
    ServerAliveInterval 15
    ServerAliveCountMax 3
    # 端口转发失败时直接退出，方便外层脚本重试，而不是挂着一个没有转发的连接
    ExitOnForwardFailure yes
    # 可选：直连容易被阻断时，经本地代理连接（connect 随 Git for Windows 一起安装）
    # ProxyCommand connect -S 127.0.0.1:7890 %h %p
