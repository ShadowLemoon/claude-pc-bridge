#!/bin/bash
# 通过反向隧道在 PC 的 Git Bash 里执行一条命令。
# - 当前目录在挂载目录下时，到 PC 上对应的目录执行；否则从 PC_ROOT 开始执行。
# - 命令里出现的挂载目录路径会换成 PC 上的路径。
# 用法: pcrun '<命令>'   或   pcrun -- <程序> <参数...>
# 设置 PC_BRIDGE_DRY_RUN=1 时只打印要在 PC 上执行的命令，不连接 PC。
set -u
LIB_DIR="$(dirname "$(readlink -f "$0")")/../lib"
# shellcheck source=../lib/common.sh
. "$LIB_DIR/common.sh"
pc_bridge_load_config

case "$PWD/" in
  "$MOUNT"/*) rel="${PWD#"$MOUNT"}" ;;
  *) rel="" ;;
esac

if [ "${1:-}" = "--" ]; then shift; fi
if [ $# -eq 0 ]; then
  echo "用法: pcrun '<命令>'  或  pcrun -- <程序> <参数...>" >&2
  exit 2
fi
if [ $# -eq 1 ]; then cmd="$1"; else cmd=$(printf '%q ' "$@"); fi

for alias in "${MOUNT_ALIASES[@]}"; do
  cmd=${cmd//"$alias"/"$PC_ROOT"}
done
remote="cd $(printf '%q' "$PC_ROOT$rel") && $cmd"

if [ "${PC_BRIDGE_DRY_RUN:-0}" = "1" ]; then
  printf '%s\n' "$remote"
  exit 0
fi

pc_bridge_require_user
pc_bridge_ssh_opts
exec ssh -T "${SSH_OPTS[@]}" "$PC_SSH_USER@$PC_SSH_HOST" "$remote"
