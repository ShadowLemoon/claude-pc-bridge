#!/bin/bash
# Claude Code 的 PreToolUse(Bash) 钩子：把操作挂载目录的命令改写成 pcrun-session 调用，在电脑上执行。
# 满足任一条件就转发：
#   1. 会话工作目录在挂载目录下
#   2. 命令里出现了挂载目录路径（绝对路径、~/...、$HOME/...，按路径边界匹配）
#   3. 命令里的相对路径按当前目录解析后落在挂载目录里
# 不转发：以 #local 开头的命令（留在 VPS 上执行）、已经是 pcrun 调用的命令。
# 不输出任何内容 = 不改写，按原样在 VPS 上执行。
set -u
BIN_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../lib/common.sh
. "$BIN_DIR/../lib/common.sh"
pc_bridge_load_config

input=$(cat)
cwd=$(jq -r '.cwd // empty' <<<"$input")
cmd=$(jq -r '.tool_input.command // empty' <<<"$input")
session=$(jq -r '.session_id // empty' <<<"$input")

case "$cmd" in
  "#local "*|"#local	"*)
    # 和命令写在同一行的 #local（如 `#local echo hi`）会让 bash 把整行当注释，什么都不执行。
    # 去掉这个前缀，剩下的命令留在 VPS 上执行。
    rest=${cmd#"#local"}
    rest=${rest#"${rest%%[![:blank:]]*}"}
    case "$rest" in "#local"*|"") exit 0 ;; esac
    jq -n --argjson ti "$(jq '.tool_input' <<<"$input")" --arg cmd "$rest" \
      '{hookSpecificOutput: {hookEventName: "PreToolUse", updatedInput: ($ti + {command: $cmd})}}'
    exit 0 ;;
  "#local"*|pcrun\ *|*/pcrun\ *|". '"*"/pcrun-session' "*) exit 0 ;;
esac

printf '%s' "$cmd" | MOUNT="$MOUNT" PC_ROOT="$PC_ROOT" perl "$BIN_DIR/../lib/pathmap.pl" check "$cwd" || exit 0

jq -n --argjson ti "$(jq '.tool_input' <<<"$input")" --arg cmd "$cmd" --arg s "$session" \
  --arg run "$BIN_DIR/pcrun-session" \
  '{hookSpecificOutput: {hookEventName: "PreToolUse",
     updatedInput: ($ti + {command: (". " + ($run | @sh) + " " + ($s | @sh) + " " + ($cmd | @sh))})}}'
