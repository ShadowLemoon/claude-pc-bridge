# claude-pc-bridge 配置示例
# 复制到 ~/.config/claude-pc-bridge/config.env 后按自己的环境修改。
# 也可以用环境变量 PC_BRIDGE_CONFIG 指定其他位置。

# PC 上 OpenSSH Server 的登录用户名（Windows 用户名）
PC_SSH_USER=your-windows-user

# 反向隧道在 VPS 上监听的地址和端口（对应 PC 端 RemoteForward 的端口）
PC_SSH_HOST=localhost
PC_SSH_PORT=2222

# VPS 登录 PC 用的私钥，对应公钥要加到 PC 的 authorized_keys
PC_SSH_KEY=$HOME/.ssh/id_ed25519_pc

# VPS 上的挂载目录。会话工作目录在这下面，或命令里出现这个路径时，命令会转发到 PC
MOUNT=$HOME/work/pc-code

# PC 上对应的目录，Git Bash 写法（pcrun 用它 cd）
PC_ROOT=/d/Code

# PC 上对应的目录，Windows OpenSSH 的 sftp 写法（sshfs 用它挂载）
PC_SFTP_PATH=/D:/Code
